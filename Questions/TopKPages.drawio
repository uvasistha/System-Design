        <mxCell id="NKc8lnMmxln-4O3GPi_p-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="Kafka" vertex="1">
