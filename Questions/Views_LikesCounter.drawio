        <mxCell id="1" parent="0" />
        <mxCell id="juIdRk5AQsDoz-bPlLgz-1" parent="1" style="text;whiteSpace=wrap;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontFamily=Comic Sans MS;" value="Design a Scalable Facebook-like System to Fetch Friends’ Count with Posts&#xa;&#xa;&#xa;Functional&#xa;Show posts in a feed&#xa;Each post displays:&#xa;    Friend count (or likes / comments)&#xa;    Counts update as users interact&#xa;&#xa;&#xa;Non-Functional&#xa;Extremely high read QPS (every feed render)&#xa;Extremely high write QPS (likes, friendships)&#xa;Eventual consistency is acceptable&#xa;P99 latency &lt; 50 ms&#xa;Must handle hot posts and hot users&#xa;&#xa;&#xa;Note: This is NOT a news feed problem.&#xa;As feed is read heavy but counters are write heavy .&#xa;We will break Feed and Counter System and focus on counter system.&#xa;Feed fetches post IDs. Counter system fetches counts&#xa;Results are merged at read time." vertex="1">
          <mxGeometry height="340" width="440" x="60" y="90" as="geometry" />
        </mxCell>
